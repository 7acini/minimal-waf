{
  "server": {
    "listen_address": "0.0.0.0:8081",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "90s",
    "shutdown_timeout": "10s"
  },
  "upstream": {
    "url": "http://php:80",
    "preserve_host": true,
    "trust_forwarded_headers": true
  },
  "waf": {
    "mode": "block",
    "max_body_bytes": 1048576,
    "max_decode_passes": 3,
    "block_status": 403,
    "inspect_methods": ["POST", "PUT", "PATCH"],
    "enabled_categories": ["lfi", "sqli", "xss"],
    "exclusions": []
  },
  "logging": {
    "level": "info"
  }
}
