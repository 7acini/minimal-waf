{
  "server": {
    "listen_address": "0.0.0.0:8081",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "90s",
    "shutdown_timeout": "10s"
  },
  "upstream": {
    "url": "http://php:80",
    "preserve_host": true,
    "trust_forwarded_headers": true
  },
  "waf": {
    "mode": "block",
    "max_body_bytes": 1048576,
    "max_decode_passes": 3,
    "block_status": 403,
    "inspect_methods": ["POST", "PUT", "PATCH"],
    "enabled_categories": ["lfi", "sqli", "xss"],
    "exclusions": []
  },
  "logging": {
    "level": "info",
    "file_path": "/var/log/minimal-waf/waf.jsonl",
    "max_size_mb": 10,
    "max_backups": 5,
    "max_age_days": 30,
    "compress": true
  }
}
